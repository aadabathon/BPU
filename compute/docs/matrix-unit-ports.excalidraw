   "locked": false
  },
  {
   "id": "text92",
   "type": "text",
   "x": 58,
   "y": 1041,
   "width": 783.0,
   "height": 243.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 838145800,
   "version": 1,
   "versionNonce": 1028162214,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "mat_cmd_t: proposed packed struct (today: a flat 154-bit body, bpu_isa_pkg Mb* offsets)\n\nfield       bits   meaning\nop          2      GEMV | GEMM | OUTER\nprofile     2      BYTE_DOT | QSTATE_S16 | QSTATE_U16 | Q824_ORDERED\na_type      3      INT4 | INT8 | INT16 | UINT16 | INT32\nb_type      3      same choices as a_type\nshift       6      fraction bits f to shift out, round-to-nearest-even\naccumulate  1      c += result (OUTER) instead of c = result\nargmax      1      write only the largest row's index (LM head; exists today)\nm, n, k     3x20   dimensions (n reaches 248,320 for the LM head)\na, b, c     3x64   views: base address + row stride; a and b in, c out\nwid         16     weight tensor id, only if weights stream (exists today)",
   "originalText": "mat_cmd_t: proposed packed struct (today: a flat 154-bit body, bpu_isa_pkg Mb* offsets)\n\nfield       bits   meaning\nop          2      GEMV | GEMM | OUTER\nprofile     2      BYTE_DOT | QSTATE_S16 | QSTATE_U16 | Q824_ORDERED\na_type      3      INT4 | INT8 | INT16 | UINT16 | INT32\nb_type      3      same choices as a_type\nshift       6      fraction bits f to shift out, round-to-nearest-even\naccumulate  1      c += result (OUTER) instead of c = result\nargmax      1      write only the largest row's index (LM head; exists today)\nm, n, k     3x20   dimensions (n reaches 248,320 for the LM head)\na, b, c     3x64   views: base address + row stride; a and b in, c out\nwid         16     weight tensor id, only if weights stream (exists today)",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
