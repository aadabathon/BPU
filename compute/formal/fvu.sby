# Control-path proofs for bpu_fvu (sequencer, read ports, credits, writeback
# arbitration, pipelined reduction merge). Lanes, the lane adder tree, the merge
# adder and the SPM contents are cut out: the properties must hold for any data.
#   prove: unbounded (IC3/PDR), 2 lanes, 2-entry reduction FIFO (maximum credit pressure)
#   bmc:   30 cycles from reset; bmc_p2 the same with two SPM read ports
#   cover: an op completes; a reduction writes its result (16 lanes: a row is 4 words)
#   cd compute/formal && sby -f fvu.sby
[tasks]
prove small
bmc small
bmc_p2
cover

[options]
prove: mode prove
bmc: mode bmc
bmc: depth 30
bmc_p2: mode bmc
bmc_p2: depth 30
cover: mode cover
cover: depth 40

[engines]
prove: abc pdr
bmc: smtbmc yices
bmc_p2: smtbmc yices
cover: smtbmc yices

[script]
small: read_slang -DFORMAL --top bpu_fvu_fv bpu_compute_pkg.sv bpu_delay.sv bpu_lzc_pow2.sv bpu_lzc.sv bpu_fifo.sv bpu_sram_1r1w_be.sv bpu_fp32_mul.sv bpu_fp32_add.sv bpu_int2fp32.sv bpu_sfu_rom_pkg.sv bpu_sfu_rom.sv bpu_sfu.sv bpu_fvu_qround.sv bpu_fvu_lane.sv bpu_fvu_sumtree.sv bpu_fvu_maxtree.sv bpu_fvu_reduce.sv bpu_fvu.sv bpu_fvu_fv.sv
bmc_p2:    read_slang -DFORMAL --top bpu_fvu_fv -G SpmReadPorts=2 bpu_compute_pkg.sv bpu_delay.sv bpu_lzc_pow2.sv bpu_lzc.sv bpu_fifo.sv bpu_sram_1r1w_be.sv bpu_fp32_mul.sv bpu_fp32_add.sv bpu_int2fp32.sv bpu_sfu_rom_pkg.sv bpu_sfu_rom.sv bpu_sfu.sv bpu_fvu_qround.sv bpu_fvu_lane.sv bpu_fvu_sumtree.sv bpu_fvu_maxtree.sv bpu_fvu_reduce.sv bpu_fvu.sv bpu_fvu_fv.sv
cover:     read_slang -DFORMAL --top bpu_fvu_fv -G VLanes=16 -G SpmWords=8 bpu_compute_pkg.sv bpu_delay.sv bpu_lzc_pow2.sv bpu_lzc.sv bpu_fifo.sv bpu_sram_1r1w_be.sv bpu_fp32_mul.sv bpu_fp32_add.sv bpu_int2fp32.sv bpu_sfu_rom_pkg.sv bpu_sfu_rom.sv bpu_sfu.sv bpu_fvu_qround.sv bpu_fvu_lane.sv bpu_fvu_sumtree.sv bpu_fvu_maxtree.sv bpu_fvu_reduce.sv bpu_fvu.sv bpu_fvu_fv.sv
prep -top bpu_fvu_fv
cutpoint t:bpu_fvu_lane* t:bpu_sram_1r1w_be* t:bpu_fvu_sumtree* */u_merge_add
flatten
opt_clean

[files]
../rtl/common/bpu_compute_pkg.sv
../rtl/common/bpu_delay.sv
../rtl/common/bpu_lzc_pow2.sv
../rtl/common/bpu_lzc.sv
../rtl/common/bpu_fifo.sv
../rtl/common/bpu_sram_1r1w_be.sv
../rtl/fp/bpu_fp32_mul.sv
../rtl/fp/bpu_fp32_add.sv
../rtl/fp/bpu_int2fp32.sv
../rtl/sfu/bpu_sfu_rom_pkg.sv
../rtl/sfu/bpu_sfu_rom.sv
../rtl/sfu/bpu_sfu.sv
../rtl/fvu/bpu_fvu_qround.sv
../rtl/fvu/bpu_fvu_lane.sv
../rtl/fvu/bpu_fvu_sumtree.sv
../rtl/fvu/bpu_fvu_maxtree.sv
../rtl/fvu/bpu_fvu_reduce.sv
../rtl/fvu/bpu_fvu.sv
bpu_fvu_fv.sv
