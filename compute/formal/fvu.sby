# Control-path proofs for bpu_fvu on a bpu_sram_shared with a competing client
# (operand collector, read tags, write buffer and credits, VVECMAT forwarding and
# accumulator ordering, pipelined reduction merge, bank arbitration). Lanes, adder
# trees, the merge adder and the memory contents are cut out: the properties must
# hold for any data and any bank contention.
#   prove:    unbounded (rIC3 and ABC PDR race; the first answer wins), 2 lanes,
#             2 slots, 2-entry write buffer and reduction FIFO (maximum credit
#             pressure). Memory hungry: run tasks one at a time (sby --sequential).
#   bmc:      25 cycles from reset; bmc_p2 the same with two read ports
#   cover:    an op completes; a reduction writes its result; a forwarded VVECMAT completes
#   cd compute/formal && sby --sequential -f fvu.sby
[tasks]
prove
bmc small
bmc_p2
cover

[options]
prove: mode prove
bmc: mode bmc
bmc: depth 25
bmc_p2: mode bmc
bmc_p2: depth 25
cover: mode cover
cover: depth 40

[engines]
prove: aiger rIC3 -e ic3
prove: abc pdr
bmc: smtbmc yices
bmc_p2: smtbmc yices
cover: smtbmc yices

[script]
small: read_slang -DFORMAL --top bpu_fvu_fv bpu_compute_pkg.sv bpu_isa_pkg.sv bpu_delay.sv bpu_lzc_pow2.sv bpu_lzc.sv bpu_fifo.sv bpu_sram_1r1w_be.sv bpu_sram_shared.sv bpu_fp32_mul.sv bpu_fp32_add.sv bpu_int2fp32.sv bpu_sfu_rom_pkg.sv bpu_sfu_rom.sv bpu_sfu.sv bpu_fvu_qround.sv bpu_fvu_lane.sv bpu_fvu_sumtree.sv bpu_fvu_maxtree.sv bpu_fvu_reduce.sv bpu_fvu.sv bpu_fvu_fv.sv
prove: read_slang -DFORMAL --top bpu_fvu_fv -G SmallAddr=1 bpu_compute_pkg.sv bpu_isa_pkg.sv bpu_delay.sv bpu_lzc_pow2.sv bpu_lzc.sv bpu_fifo.sv bpu_sram_1r1w_be.sv bpu_sram_shared.sv bpu_fp32_mul.sv bpu_fp32_add.sv bpu_int2fp32.sv bpu_sfu_rom_pkg.sv bpu_sfu_rom.sv bpu_sfu.sv bpu_fvu_qround.sv bpu_fvu_lane.sv bpu_fvu_sumtree.sv bpu_fvu_maxtree.sv bpu_fvu_reduce.sv bpu_fvu.sv bpu_fvu_fv.sv
cover: read_slang -DFORMAL --top bpu_fvu_fv -G VLanes=16 -G AccDepth=4 bpu_compute_pkg.sv bpu_isa_pkg.sv bpu_delay.sv bpu_lzc_pow2.sv bpu_lzc.sv bpu_fifo.sv bpu_sram_1r1w_be.sv bpu_sram_shared.sv bpu_fp32_mul.sv bpu_fp32_add.sv bpu_int2fp32.sv bpu_sfu_rom_pkg.sv bpu_sfu_rom.sv bpu_sfu.sv bpu_fvu_qround.sv bpu_fvu_lane.sv bpu_fvu_sumtree.sv bpu_fvu_maxtree.sv bpu_fvu_reduce.sv bpu_fvu.sv bpu_fvu_fv.sv
bmc_p2: read_slang -DFORMAL --top bpu_fvu_fv -G RdPorts=2 bpu_compute_pkg.sv bpu_isa_pkg.sv bpu_delay.sv bpu_lzc_pow2.sv bpu_lzc.sv bpu_fifo.sv bpu_sram_1r1w_be.sv bpu_sram_shared.sv bpu_fp32_mul.sv bpu_fp32_add.sv bpu_int2fp32.sv bpu_sfu_rom_pkg.sv bpu_sfu_rom.sv bpu_sfu.sv bpu_fvu_qround.sv bpu_fvu_lane.sv bpu_fvu_sumtree.sv bpu_fvu_maxtree.sv bpu_fvu_reduce.sv bpu_fvu.sv bpu_fvu_fv.sv
prep -top bpu_fvu_fv
cutpoint t:bpu_fvu_lane* t:bpu_sram_1r1w_be* t:bpu_fvu_sumtree* */u_merge_add
flatten
opt_clean

